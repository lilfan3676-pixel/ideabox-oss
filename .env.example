# ideabox 環境變數範例：複製成 .env.local（本機開發）或填到 Vercel → Settings → Environment Variables
# 標「必填」的沒填，網站會打不開；「選填」的沒填，那個功能會顯示提示、其他照常運作。

# ===== Supabase（必填，專案 Settings → API）=====
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 只有這個 Email 能登入主控台（要先在 Supabase Authentication → Users 建立這個帳號與密碼）
OWNER_EMAIL=you@example.com

# ===== Telegram（必填）=====
# 跟 @BotFather 申請的 Bot Token
TELEGRAM_BOT_TOKEN=
# 自己打一串英數字（至少 32 字，只能用英文字母、數字、_ 和 -），用來確認請求來自 Telegram
TELEGRAM_WEBHOOK_SECRET=
# 先留空，部署後傳訊息給 Bot，它會回覆你的 ID，再填進來
TELEGRAM_OWNER_ID=

# ===== Claude（必填）=====
ANTHROPIC_API_KEY=
# 選填：換模型
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
# ANTHROPIC_MODEL_RESEARCH=claude-sonnet-5-5

# ===== 其他（必填）=====
# 自己打一串英數字（至少 32 字，跟上面的不同），Vercel Cron 會用它呼叫每日排程
CRON_SECRET=
# 部署後的網址，例如 https://my-ideabox.vercel.app（結尾不要斜線；週報裡的連結、設定 webhook 都會用到）
APP_URL=

# ===== 選填 =====
# Threads 官方嵌入介面的 access token，可提高讀到貼文內容的機率
THREADS_ACCESS_TOKEN=
# GitHub 個人存取權杖（public_repo 唯讀即可），讀 GitHub 專案資訊的額度從每小時 60 次提高到 5000 次
GITHUB_TOKEN=
# Slack 進度回報：Bot User OAuth Token（xoxb- 開頭）
# 權限：channels:read channels:history channels:join groups:read groups:history
SLACK_BOT_TOKEN=
# 辦公室畫面：電腦上 Claude Code hook 回報用的密鑰（跟電腦上 ~/.claude/ideabox-hook.secret 同一串）
CLAUDE_HOOK_SECRET=
# 話題雷達：Apify 抓 Threads 關鍵字貼文（apify.com → Settings → API & Integrations → Personal API token）
APIFY_TOKEN=
