{
  "expo": {
    "name": "ideabox",
    "slug": "ideabox",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ideabox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.ideabox",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh_TW",
        "CFBundleLocalizations": [
          "zh_TW"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.ideabox",
      "adaptiveIcon": {
        "backgroundColor": "#0d0716",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "用相機掃描 ideabox 設定頁上的配對 QR code。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111111"
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    }
  }
}