{
  "expo": {
    "name": "ideabox",
    "slug": "ideabox",
    "version": "2.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ideabox",
    "userInterfaceStyle": "dark",
    "ios": {
      "bundleIdentifier": "com.example.ideabox",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh_TW",
        "CFBundleLocalizations": [
          "zh_TW",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.ideabox",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "用相機掃描 ideabox 設定頁上的配對 QR code。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111111"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-ball-inv.png",
          "imageWidth": 140,
          "backgroundColor": "#090a0e"
        }
      ],
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "IdeaboxNext",
              "displayName": "下一件",
              "description": "接下來最近的一件事",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium"
                ]
              }
            },
            {
              "name": "IdeaboxToday",
              "displayName": "今天",
              "description": "今天做完幾件、今天的時間軸",
              "ios": {
                "supportedFamilies": [
                  "systemSmall",
                  "systemMedium",
                  "systemLarge"
                ]
              }
            },
            {
              "name": "IdeaboxProjects",
              "displayName": "各專案的下一步",
              "description": "每個進行中專案的下一步",
              "ios": {
                "supportedFamilies": [
                  "systemMedium",
                  "systemLarge"
                ]
              }
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    },
    "backgroundColor": "#090a0e"
  }
}
