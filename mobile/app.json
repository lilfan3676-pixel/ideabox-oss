{
  "expo": {
    "name": "ideabox",
    "slug": "ideabox",
    "version": "2.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "ideabox",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.example.ideabox",
      "supportsTablet": false,
      "infoPlist": {
        "CFBundleDevelopmentRegion": "zh_TW",
        "CFBundleLocalizations": [
          "zh_TW",
          "en"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.example.ideabox",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "用相機掃描 ideabox 設定頁上的配對 QR code。",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#111111"
        }
      ],
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-ball.png",
          "imageWidth": 140,
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/logo-ball-inv.png",
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {}
    },
    "backgroundColor": "#ffffff"
  }
}
